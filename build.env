# Basalt - 构建配置
# mkosi 管线：发行版/包/分区见 mkosi/mkosi.conf 与 mkosi.repart/

# Landscape 发布版本（latest 或 vX.Y.Z）
LANDSCAPE_VERSION="${LANDSCAPE_VERSION-latest}"
LANDSCAPE_REPO="${LANDSCAPE_REPO-https://github.com/ThisSeanZhang/landscape}"

# 镜像标识：mkosi ImageId / 产物名 / UKI 文件名 / cmdline basalt.image= 的
# 同源前缀（经 --image-id 覆盖 mkosi.conf；版本后缀由 build.sh 按构建版本注入）
IMAGE_ID="${IMAGE_ID-basalt}"

# 是否包含 Docker（true/false）
INCLUDE_DOCKER="${INCLUDE_DOCKER-false}"

ROOT_PASSWORD="${ROOT_PASSWORD-landscape}"
TIMEZONE="${TIMEZONE-Asia/Shanghai}"

# 镜像名义尺寸（MiB）：留空 = 自适应（ESP + var 静息 × IMAGE_HEADROOM +
# (INSTANCES_MAX-1) 份 EROFS 镜像 + ROOT_MARGIN_MB，构建日志打印计算式）；
# 显式设置时优先于计算值
IMAGE_SIZE_MB="${IMAGE_SIZE_MB-}"
IMAGE_HEADROOM="${IMAGE_HEADROOM-2}"

# 版本保留深度：sysupdate InstancesMax（build.sh 暂存渲染统一替换 70/80 transfer）
# 与 ESP 预算（槽倍数 = INSTANCES_MAX+1 更新瞬态）、名义盘镜像份数同源
INSTANCES_MAX="${INSTANCES_MAX-3}"

# 输出格式（有序逗号分隔）: img,vmdk,ova
OUTPUT_FORMATS="${OUTPUT_FORMATS-img}"
COMPRESS_OUTPUT="${COMPRESS_OUTPUT-yes}"

# 本地验证: none | readiness | readiness,dataplane
RUN_TEST="${RUN_TEST-none}"

# 时区/locale（经 mkosi 原生 --timezone/--locale 应用）
LOCALE="${LOCALE-C.UTF-8}"

# APT 镜像（mkosi --mirror 直通；留空用发行版默认源）
APT_MIRROR="${APT_MIRROR-}"