# Old deployment subvolumes → read-only (post-update cleanup, idempotent oneshot).
# Runs every boot (more robust than tying to bless chain: bless one-shot timing is
# hard to hook; boot-time cleanup covers manual deletes/reinstalls and arbitrary
# state trajectories). After=var-lib-basalt-pool.mount: property ops require pool
# top-level mount ready (fstab-generated unit name).
[Unit]
Description=Mark non-running basalt deployments read-only
After=var-lib-basalt-pool.mount
RequiresMountsFor=/var/lib/basalt/pool

[Service]
Type=oneshot
ExecStart=/usr/lib/basalt/basalt-deployments-readonly

[Install]
WantedBy=multi-user.target