# @landscape payload independent update (manual/orchestrated oneshot; no timer
# — payload freshness strategy is deployor's call; systemctl start updates).
# After=var-lib-basalt-landscape.mount: landing point is @landscape subvolume mount.
[Unit]
Description=Update Landscape payload subvolume (@landscape)
After=var-lib-basalt-landscape.mount
RequiresMountsFor=/var/lib/basalt/landscape
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/basalt/basalt-landscape-update
# Large download window (tens of MB), budget relaxed.
TimeoutStartSec=20m