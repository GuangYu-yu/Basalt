# Device state skeleton init (idempotent oneshot, every boot)
# Ordering contract: sshd doesn't guarantee running after local mounts, explicit deps:
#   After=var.mount — state dir in @data (var.mount = fstab-generated unit name)
#   Before=ssh.service — HostKey gen before sshd config test
#   Before=networking.service — interfaces source dir ready before ifup
#   Before=systemd-machine-id-commit.service — downgrade backfill before commit semantics
[Unit]
Description=Basalt device state skeleton init
After=var.mount
RequiresMountsFor=/var/lib/basalt
Before=ssh.service networking.service systemd-machine-id-commit.service

[Service]
Type=oneshot
ExecStart=/usr/lib/basalt/basalt-state-init

[Install]
WantedBy=multi-user.target