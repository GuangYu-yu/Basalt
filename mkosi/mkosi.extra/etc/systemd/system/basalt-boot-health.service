# Boot health gate (Automatic Boot Assessment business success criterion).
# API listener ready (first hop of readiness contract) → boot-complete.target
# reached → systemd-bless-boot.service decrements tries and locks new version;
# timeout failure → boot-complete not reached → bless not triggered → reboot
# burns tries → systemd-boot auto-falls back to old version.
# Listener probe only (no embedded API credentials): landscape-router is
# Type=exec + Restart=always, process liveness strongly couples to listener
# ready; listener timeout = business-level fault.
# No [Install]: pulled in by boot-complete.target Requires drop-in. Only when
# the current boot entry carries tries counter (OTA version) does
# systemd-bless-boot-generator pull bless → boot-complete → this unit into the
# boot transaction (factory first boot doesn't run it).
[Unit]
Description=Basalt boot health gate (API listener) for bless
After=landscape-router.service
Before=boot-complete.target

[Service]
Type=oneshot
# Failure visibility: probe-timeout messages sync to console (serial) — the
# only observation surface for boot-level business faults (OTA tests hard-reset,
# failure mode without SSH must be diagnosed via serial log).
StandardOutput=journal+console
StandardError=journal+console
# Each round curl(≤3s) + sleep 3s, upper bound 40 rounds (≈240s, matches
# TimeoutStartSec); TimeoutStartSec=240 guards curl hang.
ExecStart=/bin/sh -ec 'i=0; while [ $i -lt 40 ]; do curl -skI --max-time 3 https://localhost:6443/ -o /dev/null && exit 0; i=$((i+1)); sleep 3; done; echo "API listener not ready after ${i} probes" >&2; exit 1'
TimeoutStartSec=240