[Unit]
Description=Dump runtime evidence to serial console (DIAG builds only)
# 仅 DIAG_CMDLINE=1 构建启用（内核参数 diag）；journal 只收 systemd 单元流，
# webserver 自管日志与网络状态在普通排障串口里不可见，此服务补盲区
ConditionKernelCommandLine=diag
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -ec 'sleep 30; { echo "===== diag-dump ====="; date -u; echo "--- findmnt ---"; findmnt; echo "--- ip addr ---"; ip addr; echo "--- home ls ---"; ls -la /root/.landscape-router/ 2>&1; echo "--- init toml ---"; head -n 8 /root/.landscape-router/landscape_init.toml 2>&1 || true; echo "--- root-part inspect ---"; mkdir -p /mnt/rootpart; for p in /dev/disk/by-partlabel/basalt*; do echo "== mount $p"; mount -o ro "$p" /mnt/rootpart 2>&1 || true; if mountpoint -q /mnt/rootpart; then ls -la /mnt/rootpart/var/lib/landscape/ /mnt/rootpart/usr/share/landscape/ 2>&1 || true; umount /mnt/rootpart; fi; done; } > /dev/console; exit 0'
# 第二阶段：landscape-router 完成 TC/eBPF attach 后再取证（区分 webserver
# 故障与入站路径被数据面拦截：本地 curl 走 lo，SSH hostfwd 走 eth0 入站）
ExecStart=/bin/sh -ec 'sleep 200; { echo "===== diag-dump-2 ====="; date -u; echo "--- tc qdisc ---"; tc qdisc show; echo "--- tc filter eth0 ---"; tc filter show dev eth0 ingress; tc filter show dev eth0 egress; echo "--- webserver local probe ---"; curl -sk -o /dev/null -w "interfaces/all http_code=%{http_code}\n" --max-time 5 https://127.0.0.1:6443/api/v1/interfaces/all; curl -sk --max-time 5 https://127.0.0.1:6443/api/v1/interfaces/all | head -c 600; echo; echo "--- listening ---"; ss -tlnp; echo "--- landscape-router journal ---"; journalctl -u landscape-router -n 60 --no-pager; echo "--- dmesg tail ---"; dmesg | tail -n 30; } > /dev/console; exit 0'

[Install]
WantedBy=multi-user.target
