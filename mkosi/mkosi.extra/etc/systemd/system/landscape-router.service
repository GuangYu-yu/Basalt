[Unit]
Description=Landscape Router
# Partition/filesystem growth done by initrd systemd-repart (before switch_root);
# no extra order dep on application unit; @landscape payload mounts before this
# unit (local-fs target).
After=local-fs.target

[Service]
Type=exec
# /usr-etc-var three-layer contract:
#   Payload (webserver/static/toml) = @landscape subvolume (/var/lib/basalt/landscape,
#     decoupled from root OTA); -w explicit webroot removes binary default-path ambiguity
#   Runtime state = @data: WorkingDirectory=/var/lib/landscape holds relative-path
#     writes; /root/.landscape-router is a build-time symlink → /var/lib/landscape
#     (upstream hardcoded HOME compat layer)
# StateDirectory auto-creates the working directory (independent /var partition,
# not guaranteed present at build time).
StateDirectory=landscape
WorkingDirectory=/var/lib/landscape
# Factory-default topology → home (/var lives on independent partition, no business
# files at build time; factory-default toml ships with @landscape payload; if home
# already has config, leave it alone. Factory reset = rm -rf /var).
# Factory seed (copy-if-missing) and boot decision (start toml → import, else Web
# bootstrap) are done in one shell — single source of truth for business rules;
# runtime decides by actual file state, no build-time pre-rendered flag files.
ExecStart=/bin/sh -ec 'if [ ! -e /var/lib/landscape/landscape_init.toml ] && [ -e /var/lib/basalt/landscape/landscape_init.toml ]; then cp /var/lib/basalt/landscape/landscape_init.toml /var/lib/landscape/; fi; if [ -f /var/lib/landscape/landscape_init.toml ]; then exec /var/lib/basalt/landscape/landscape-webserver -w /var/lib/basalt/landscape/static; else exec /var/lib/basalt/landscape/landscape-webserver -w /var/lib/basalt/landscape/static --auto; fi'
Restart=always
RestartSec=2
LimitMEMLOCK=infinity
# eBPF map pin (/sys/fs/bpf is tmpfs semantics, writable by nature).
ExecStartPre=/bin/sh -c 'mountpoint -q /sys/fs/bpf || mount -t bpf bpf /sys/fs/bpf'

[Install]
WantedBy=multi-user.target