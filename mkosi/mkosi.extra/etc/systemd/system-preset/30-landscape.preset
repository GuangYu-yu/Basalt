# Service enable strategy — mkosi runs `systemctl preset-all` at build end
# (mkosi.1 build order: sysusers → tmpfiles → preset-all). /etc/system-preset
# takes precedence over distro /usr/lib/system-preset; sole source of truth for
# which services are enabled in the image.
enable landscape-router.service
enable basalt-state-init.service
enable basalt-deployments-readonly.service
# OTA prerequisite invariant: pool btrfs quota (see unit comment).
enable basalt-pool-quota.service
enable ssh.service
enable networking.service
enable chrony.service
enable systemd-sysupdate.timer
# First-boot var partition growth (/etc/repart.d/92-var-grow.conf + dropin).
enable systemd-repart.service
# Dual network-stack / dual-NTP hardening: force off even if upstream default
# has them enabled.
disable systemd-resolved.service
disable NetworkManager.service
disable systemd-timesyncd.service