# 临时诊断：就绪性自动取证（与 readiness-dump.sh 同生命周期，用后即删）。
# After=multi-user.target：target 完成后启动；sleep 20 给 landscape/sshd 首启
# 时间（TCG 慢），journal 历史仍可读全。
[Unit]
Description=Readiness diagnostic dump (temporary)
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -ec 'sleep 20; /usr/lib/systemd/readiness-dump.sh'

[Install]
WantedBy=multi-user.target
