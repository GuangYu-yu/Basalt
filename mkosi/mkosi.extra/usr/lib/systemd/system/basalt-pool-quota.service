[Unit]
Description=Basalt pool btrfs quota enable (filesystem invariant)
# OTA prerequisite invariant: sysupdate url-tar → subvolume target creates
# default qgroup hierarchy for temporary deployments; kernel 6.12+ btrfs
# returns -ENOTCONN on qgroup ioctl when quota is off, but systemd-pull only
# tolerates -ENOTTY → update hard-fails. Quota is per-filesystem persistent
# metadata, a filesystem-init invariant (machinectl does the same for
# /var/lib/machines pool, machine-pool.c); neither mkfs.btrfs nor systemd-
# repart have an enable option, so converged at first boot. When already
# enabled kernel returns 0 directly (idempotent no-op, self-healing too).
After=var.mount
Before=systemd-sysupdate.service

[Service]
Type=oneshot
ExecStart=/usr/bin/btrfs quota enable /var/lib/basalt/pool
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target