[Unit]
Description=Basalt pool btrfs quota enable (filesystem invariant)
# OTA 前置不变量：sysupdate url-tar → subvolume 目标会为临时部署子卷建立
# 默认 qgroup 层级，内核 6.12+ 对 quota 关闭的 btrfs 的 qgroup ioctl 返回
# -ENOTCONN，而 systemd-pull 仅容忍 -ENOTTY → 更新硬失败。quota 是
# per-filesystem 持久元数据，属文件系统初始化不变量（machinectl 对
# /var/lib/machines 池同款，machine-pool.c）；mkfs.btrfs/systemd-repart
# 均无启用选项，故首启收敛。已启用时内核直接返回 0（幂等 no-op，兼自愈）
After=var.mount
Before=systemd-sysupdate.service

[Service]
Type=oneshot
ExecStart=/usr/bin/btrfs quota enable /var/lib/basalt/pool
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
