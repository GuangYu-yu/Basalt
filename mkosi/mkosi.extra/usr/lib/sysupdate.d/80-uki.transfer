# Device-side sysupdate transfer — UKI (entry-point resource)
# Transfer file name alphabetical order determines write order: entry point
# (UKI) written last (80 > 70-root). Aborted interrupts leave only a harmless
# half-state of "deployment without entry point" (sysupdate.d(5) two-phase
# semantics: download+extract all to temp first, then rename finalize + fsync
# alphabetically by transfer file name).
# Versioned UKI files kept: old UKI entries remain bootable = rollback path.
# InstancesMax=2 matches 70-root.transfer (deployment retention depth =
# architecture constant); rescue UKI (basalt-rescue.efi) doesn't match
# MatchPattern, vacuum leaves it untouched.
# ESP mount point fixed by fstab PARTLABEL=ESP entry (/efi).
# Resource model = versioned single file (regular-file): Path= holds multi-
# version directory, MatchPattern= names files within (boot counting file name,
# @l/@d three-section form).
[Transfer]
# Running-version UKI also protected by ProtectVersion=%A (matches 70-root):
# vacuum must not delete the currently booted UKI — without this the current
# version is treated as an old instance and cleaned up (empiric lesson).
ProtectVersion=%A
Verify=no

[Source]
Type=url-file
Path=updates.example.com/basalt/
MatchPattern=basalt_@v.efi

[Target]
Type=regular-file
Path=/efi/EFI/Linux
# @l/@d glob (sysupdate.d(5)): expands to TriesLeft/TriesDone on install;
# matches any counting state on enumeration (+3-0 fresh / +2-1 / +0-3 bad).
# Literal +3-0/+3 forms tested as a serious bug — intermediate/bad state
# instances invisible to sysupdate → version inventory corruption → "make
# room" vacuum deletes the running bless version (empiric basalt_2.efi deleted
# → rollback fell to v1).
MatchPattern=basalt_@v+@l-@d.efi \
             basalt_@v.efi
TriesLeft=3
TriesDone=0
InstancesMax=2