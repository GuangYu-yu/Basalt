# 设备侧 sysupdate transfer —— root A/B 分区
# systemd-sysupdate.timer（postinst enable）定时消费；`systemd-sysupdate list/update`
# 手动触发同用此定义。
#
# 语义（sysupdate.d(5)）：
#   - 标签承载版本：Target MatchPattern 中的 @v 必选；写入完成后分区被重命名为
#     basalt_<版本>。
#   - 版本即槽位：sysupdate 重命名标签后，新版本 UKI（cmdline 绑
#     root=PARTLABEL=basalt_<版本>，build.sh 按构建版本写入）
#     自描述其根分区，与标签簿记同源；引导顺序由 systemd-boot 按版本排序
#     决定。
#   - 幂等：目标已是该版本时 update 为 no-op。
# url-file 源要求发布目录提供 SHA256SUMS 清单（sysupdate.d(5) 的版本枚举
# 与完整性校验机制）；清单由发布方生成，占位 URL 保持占位。
[Transfer]
Notify=stdout

[Source]
Type=url-file
Path=https://updates.example.com/basalt/
MatchPattern=basalt_@v.raw.xz

[Target]
Type=partition
Path=auto
MatchPattern=basalt_@v
MatchPartitionType=root
InstancesMax=2
PartitionFlags=0