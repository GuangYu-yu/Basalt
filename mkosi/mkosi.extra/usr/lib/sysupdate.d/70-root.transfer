# 设备侧 sysupdate transfer —— 根部署子卷（btrfs subvolume 目标）
# systemd-sysupdate.timer（postinst preset enable）定时消费；
# `systemd-sysupdate list/update` 手动触发同用此定义。
#
# 语义（sysupdate.d(5) 官方核对，v257 可用）：
#   - url-tar 源 → subvolume 目标为受支持组合（资源类型矩阵：url-tar 的
#     Compatible Targets = directory, subvolume）
#   - 版本枚举走 SHA256SUMS 清单（GET <Path>/SHA256SUMS），下载 payload
#     无条件对清单校验；Verify= 只控制清单的 GPG 签名验证
#   - 解包走 systemd-import tar --direct --btrfs-subvol=yes（内部 GNU tar
#     --xattrs --xattrs-include=*——capabilities/xattr 全保留，与构建侧
#     mkosi make_tar 的 GNU tar --acls --xattrs PAX 同构）
#   - Target MatchPattern 命名新子卷：root-basalt-@v（连字符前缀固定，
#     不随 IMAGE_ID 渲染；UKI cmdline 的 subvol= 同源）
#   - InstancesMax=2：更新发起时保证不超过 1 个旧版本存在，超出即删
#     （即用即弃 A/B：当前 rw + 一个旧 ro，需求上限）
#   - RemoveTemporary=（默认 yes）：更新前清理上次不完整残留（临时子卷）
#   - 刻意不设 ReadOnly=：它只对新写入的子卷生效（写时标记），而新部署
#     是下次启动的运行根，必须 rw。旧部署转 ro 由收尾单元
#     deployments-readonly.service 承载（保护性优化，非正确性前提）
#   - Path=/var/lib/basalt/pool = fstab 池顶层挂载点（subvolid=5）：
#     sysupdate 在此创建 root-basalt-<v> 子卷。Path=/ 会让子卷落在调用
#     进程根（运行部署内部）→ 嵌套子卷静默事故，见 fstab 注释
#   - 幂等：目标已是该版本时 update 为 no-op
#   - InstancesMax 与 80-uki.transfer 保持一致（sysupdate.d(5) 明示建议各
#     transfer 一致，否则残留不完整组合；两资源同版本号成对安装、成对 vacuum）
[Transfer]
ProtectVersion=%A

[Source]
Type=url-tar
Path=https://updates.example.com/basalt/
MatchPattern=basalt_@v.tar.zst

[Target]
Type=subvolume
Path=/var/lib/basalt/pool
MatchPattern=root-basalt-@v
InstancesMax=2
