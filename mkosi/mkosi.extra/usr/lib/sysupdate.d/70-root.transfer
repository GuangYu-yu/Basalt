# Device-side sysupdate transfer — root deployment subvolume (btrfs target)
# Consumed by systemd-sysupdate.timer (preset enable in postinst);
# `systemd-sysupdate list/update` manual trigger uses the same definition.
#
# Semantics (verified against sysupdate.d(5), v257 works):
#   - url-tar source → subvolume target is a supported combination (resource
#     type matrix: url-tar Compatible Targets = directory, subvolume)
#   - Version enumeration walks SHA256SUMS manifest (GET <Path>/SHA256SUMS),
#     downloads payload and unconditionally verifies manifest; Verify= only
#     controls GPG signature validation of the manifest itself
#   - Extract via systemd-import tar --direct --btrfs-subvol=yes (internal GNU
#     tar --xattrs --xattrs-include=* — capabilities/xattrs fully preserved,
#     same shape as build-side mkosi make_tar GNU tar --acls --xattrs PAX)
#   - Target MatchPattern names new subvolume: root-basalt-@v (hyphen prefix
#     fixed, not rendered from IMAGE_ID; UKI cmdline subvol= is the source
#     of truth)
#   - InstancesMax=2: at most 1 old version kept when update starts, excess
#     deleted (use-and-discard A/B: current rw + one old ro, sufficient)
#   - RemoveTemporary= (default yes): clean up previous incomplete residue
#     (temporary subvol) before update
#   - Deliberately not setting ReadOnly=: it only affects newly written
#     subvolumes (write-time mark), but a new deployment is the next boot's
#     running root and must be rw. Old→ro is handled by the post-update unit
#     deployments-readonly.service (protective optimization, not correctness)
#   - Path=/var/lib/basalt/pool = fstab pool top-level mount (subvolid=5):
#     sysupdate creates root-basalt-<v> here. Path=/ would land subvolumes
#     inside the running deployment → silent nested-subvolume accident, see
#     fstab comment
#   - Idempotent: update is a no-op when target is already this version
#   - InstancesMax kept in sync with 80-uki.transfer (sysupdate.d(5) explicitly
#     recommends matching across transfers, else incomplete pairs remain; the
#     two resources install/vacuum as a matched pair by version number)
#   - Payload compressed as xz: systemd 257 pull-stream compression probe
#     (import-compress.c) only identifies xz/gzip/bzip2 magic; zstd payload
#     gets fed raw to GNU tar → install failure
[Transfer]
ProtectVersion=%A
# TLS + SHA256SUMS payload hash already double-guarantees transport integrity;
# signature chain has no key management, leaving Verify=yes forces SHA256SUMS.gpg
# fetch → 404 → sysupdate exit 1.
Verify=no

[Source]
Type=url-tar
# Path carries no scheme: placeholder domain rendered by build.sh sed into a
# full URL with scheme (template with https:// prefix double-renders — empiric
# "Could not resolve hostname").
Path=updates.example.com/basalt/
MatchPattern=basalt_@v.tar.xz

[Target]
Type=subvolume
Path=/var/lib/basalt/pool
MatchPattern=root-basalt-@v
InstancesMax=2