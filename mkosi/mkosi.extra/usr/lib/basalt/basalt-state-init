#!/bin/sh
# basalt-state-init — idempotent device identity skeleton init (@data /var/lib/basalt/state)
# /usr-etc-var three-way split: /etc is versioned (atomically updates with deployments),
# all device-specific state lives in @data state dir, persistent across versions.
# Per-item idempotent: single-item failure doesn't block others (skeleton is
# rebuildable derivative; the only hard contract machine-id goes through initrd
# bind mount, this script only handles downgrade backfill).
set -u

STATE=/var/lib/basalt/state

# Skeleton dirs: ssh (HostKey target) / network (interfaces source pull-in) /
# pool, landscape mount points (systemd mount units auto-create, explicit fallback).
mkdir -p "${STATE}/ssh" "${STATE}/network" /var/lib/basalt/pool /var/lib/basalt/landscape

# machine-id downgrade backfill: normal path uses initrd basalt-initrd-state-bind
# to bind state/machine-id over /etc/machine-id (pid1 writes through). On bind
# failure, pid1 writes generated ID into the deployment subvolume's /etc/machine-id
# (version-local temp value) — backfill to state so next boot bind recovers
# stable identity.
if [ ! -s "${STATE}/machine-id" ] && [ -s /etc/machine-id ]; then
    cp /etc/machine-id "${STATE}/machine-id" || \
        echo "basalt-state-init: machine-id backfill failed (downgrade path, retry next boot)" >&2
fi

# SSH host keys: HostKey points to state (sshd_config.d/60-state-hostkeys.conf);
# generate on missing (idempotent: < /dev/null prevents interactive hang; warn
# only on failure, sshd ExecStartPre guard will fail explicitly).
gen_key() {
    # $1 = type, $2 = rsa bits (empty for ed25519).
    key="${STATE}/ssh/ssh_host_${1}_key"
    [ -f "${key}" ] && return 0
    if [ -n "${2:-}" ]; then
        ssh-keygen -q -t "${1}" -b "${2}" -N '' -f "${key}" </dev/null >/dev/null 2>&1
    else
        ssh-keygen -q -t "${1}" -N '' -f "${key}" </dev/null >/dev/null 2>&1
    fi || echo "basalt-state-init: ssh_host_${1}_key generation failed" >&2
}
gen_key ed25519 ""
gen_key rsa 3072

exit 0