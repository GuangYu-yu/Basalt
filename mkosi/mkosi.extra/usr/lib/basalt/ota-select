#!/bin/sh
# OTA candidate entry selection: called after sysupdate successfully writes to
# disk. At most one boot-counting entry with '+' exists = candidate installed
# this run (bless strips suffix, vacuum cleans old versions, same-version paired
# install are all established contracts).
# bootctl set-oneshot takes boot entry ID: sd-boot discovers Type 2 UKI entry IDs
# = full file name (incl .efi, matches bootctl list id column); missing suffix
# writes an unmatchable variable and silently fails. OneShot takes priority over
# all defaults; firmware auto-clears after read, subsequent retry/rollback left
# to boot counting + sort.
set -e

new="$(ls /efi/EFI/Linux/*+*.efi 2>/dev/null | sort -V | tail -1 || true)"
[ -n "${new}" ] || exit 0
/usr/bin/bootctl set-oneshot "$(basename "${new}")"