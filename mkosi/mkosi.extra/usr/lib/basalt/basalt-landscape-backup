#!/bin/sh
# basalt-landscape-backup — manual landscape runtime backup
# Target: /var/lib/landscape (WorkingDirectory in @data) holds all landscape
# runtime state — sqlite DB (authoritative config source) + landscape.toml
# (runtime file config) + landscape_init.toml (import/export snapshot) + logs/.
# Backup = entire directory tar, which keeps toml/DB naturally coupled.
# Why whole directory tar, not per-subvolume snapshot: runtime is a single
# directory tree + binary sqlite; no subvolume-level snapshot needed. tar
# preserves file attributes and restores consistent directory state on cover.
# Designed for manual invocation only (not enabled as a systemd unit) — zero
# impact on boot/OTA test paths.
# Consistency: sqlite uses WAL mode; running copy omits uncommitted WAL
# segments → stop the service before backup (restore does the same).
# Usage: basalt-landscape-backup [target dir] (default /var/lib/basalt/landscape-backups)
set -eu

SRC=/var/lib/landscape
DEST_DEFAULT=/var/lib/basalt/landscape-backups
DEST="${1:-${DEST_DEFAULT}}"

[ -d "${SRC}" ] || { echo "basalt-landscape-backup: ${SRC} not found (landscape not initialized?)" >&2; exit 1; }

mkdir -p "${DEST}"
STAMP="$(date +%Y%m%d-%H%M%S)"
OUT="${DEST}/landscape-backup-${STAMP}.tar"

echo "Stopping landscape-router for WAL-consistent backup..."
systemctl stop landscape-router.service || echo "basalt-landscape-backup: landscape-router stop failed (continuing; WAL may be incomplete)" >&2

# tar the entire runtime directory; nothing outside /var/lib/landscape.
# Remove partial output on failure.
if ! tar -C /var/lib -cf "${OUT}" landscape; then
    rm -f "${OUT}"
    echo "basalt-landscape-backup: tar failed" >&2
    systemctl start landscape-router.service || true
    exit 1
fi

systemctl start landscape-router.service || echo "basalt-landscape-backup: landscape-router start failed after restore (manual check)" >&2

echo "basalt-landscape-backup: done → ${OUT}"
echo "basalt-landscape-backup: restore with basalt-landscape-restore ${OUT}"