#!/bin/sh
# basalt-deployments-readonly — mark old deployment subvolumes read-only
# Runs idempotently at boot: marks all pool root-basalt-* subvolumes except
# the currently running one btrfs ro=true. Property-level ro (not mount-level):
# remount,ro EBUSY is expected on a subvolume in use from another rw mount in
# the same superblock; btrfs property ro=true is the correct carrier.
# Failure semantics: per-entry failures warn only (ro is an optimization;
# btrfs delete ioctls are unaffected by the ro property).
# Rollback companion: basalt-initrd-sysrw.service flips the booted target's
# ro=false before mount (ro subvolume has no rw mount option, must flip first).
set -u

# Current running deployment: UKI cmdline hardcodes subvol=root-basalt-<N>.
# In rescue (no subvol=) cur is empty — mark everything ro, rescue-select
# flips the chosen one back to rw before mounting.
cur="$(sed -n 's/.*subvol=\(root-basalt-[0-9][0-9]*\).*/\1/p' /proc/cmdline)"

for d in /var/lib/basalt/pool/root-basalt-[0-9]*; do
    [ -d "$d" ] || continue
    [ "$(basename "$d")" = "$cur" ] && continue
    if ! btrfs property get -ts "$d" ro 2>/dev/null | grep -q '^ro=true$'; then
        btrfs property set -ts "$d" ro true 2>/dev/null \
            || echo "basalt-deployments-readonly: $d failed to set ro (ignored)" >&2
    fi
done

exit 0