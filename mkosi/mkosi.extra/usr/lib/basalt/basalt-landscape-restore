#!/bin/sh
# basalt-landscape-restore — manual landscape runtime restore
# Overwrites /var/lib/landscape with a tar produced by basalt-landscape-backup.
# Safety premise: sqlite WAL mode → landscape-router must be stopped before
# replacing directory contents (avoids DB lock / stale WAL segments). Full
# directory replacement guarantees consistency, same granularity as backup.
# Usage: basalt-landscape-restore <backup.tar>
set -eu

SRC=/var/lib/landscape
[ $# -ge 1 ] || { echo "Usage: basalt-landscape-restore <backup.tar>" >&2; exit 2; }
TAR="$1"
[ -f "${TAR}" ] || { echo "basalt-landscape-restore: backup file not found: ${TAR}" >&2; exit 1; }

echo "Stopping landscape-router for WAL-consistent restore..."
systemctl stop landscape-router.service

# Pre-check: backup tar must contain a top-level landscape/ entry to avoid
# extracting wrong contents after we empty the directory.
if ! tar -tf "${TAR}" | grep -q '^landscape/'; then
    echo "basalt-landscape-restore: ${TAR} has no top-level landscape/ entry, refusing to restore" >&2
    exit 1
fi

# Empty directory contents but keep the directory itself (fstab mount point /
# WorkingDirectory depend on it). Removes -wal/-shm alongside (old WAL pairs
# with old DB; restore from tar provides the complete consistent state).
# find -mindepth 1 avoids rm -rf matching . / .. and plays safer with set -u.
find "${SRC:?}" -mindepth 1 -delete 2>/dev/null || true

if ! tar -C /var/lib -xf "${TAR}" landscape; then
    echo "basalt-landscape-restore: extract failed (/var/lib/landscape emptied; backup again)" >&2
    systemctl start landscape-router.service || true
    exit 1
fi

systemctl start landscape-router.service || echo "basalt-landscape-restore: landscape-router start failed (manual check)" >&2

echo "basalt-landscape-restore: restored /var/lib/landscape from ${TAR}"