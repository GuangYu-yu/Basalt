#!/bin/sh
# basalt-landscape-update — @landscape payload independent update (minimal unit).
# Payload = landscape-webserver + static/ (landscape_init.toml is a build-time CI
# injected factory seed; not distributed with upstream release, won't be updated
# here; device home initialized config stays untouched). Decoupled from root OTA:
# no extra sysupdate transfer / version state machine introduced.
#
# Source & verification: reuses upstream Landscape GitHub Releases (same fetch path
# as build.sh). Source URL overridable via /etc/basalt/landscape-update.conf
# LANDSCAPE_RELEASE_URL. SHASUM256sum.txt (upstream asset) strong-verifies items
# if present; falls back to curl -f transport-level check + explicit warn on miss.
# Atomic landing: all resources stage in temp dir and verify, then rename into
# place item-by-item (atomic within same subvolume), finally restart landscape-router
# for new binary process.
set -eu

DEST=/var/lib/basalt/landscape
CONF=/etc/basalt/landscape-update.conf
RELEASE_URL="https://github.com/ThisSeanZhang/landscape/releases/latest/download/"
[ -f "${CONF}" ] && . "${CONF}"   # LANDSCAPE_RELEASE_URL=... can override

TMP="$(mktemp -d /run/basalt-landscape-update.XXXXXX)"
trap 'rm -rf "${TMP}"' EXIT

fetch() { curl -fL --retry 3 -o "$2" "${RELEASE_URL}/$1"; }

fetch landscape-webserver-x86_64 "${TMP}/landscape-webserver"
chmod 0755 "${TMP}/landscape-webserver"
fetch static.zip "${TMP}/static.zip"
unzip -oq "${TMP}/static.zip" -d "${TMP}/"
[ -d "${TMP}/static" ] || { echo "static.zip produced no static/ dir after extract" >&2; exit 1; }

# Optional integrity check: strong-verify via SHASUM256sum.txt if source has it
# (only verifies this run's downloaded items). Manifest uses upstream asset names
# (landscape-webserver-x86_64), local landing name is landscape-webserver; sed
# rewrites manifest names to local names before checking.
if fetch SHASUM256sum.txt "${TMP}/SHASUM256sum.txt" 2>/dev/null; then
    ( cd "${TMP}" && grep -E 'landscape-webserver-x86_64$|static\.zip$' SHASUM256sum.txt \
        | sed 's/  landscape-webserver-x86_64$/  landscape-webserver/' \
        | sha256sum -c - ) || { echo "SHASUM256sum.txt verification failed" >&2; exit 1; }
else
    echo "basalt-landscape-update: source has no SHASUM256sum.txt, skipping per-file check (transport-level check passed)" >&2
fi

# Atomic per-item replace: each rename is atomic; whole replace is NOT — brief
# window old binary + new static coexist (webserver Restart=always + final restart
# converge, accepted); failure aborts leaving old payload intact (.old rollback
# residue cleaned on next successful update).
for item in landscape-webserver static; do
    rm -rf "${DEST}.${item}.old"
    [ -e "${DEST}/${item}" ] && mv "${DEST}/${item}" "${DEST}.${item}.old"
    mv "${TMP}/${item}" "${DEST}/${item}"
done
rm -rf "${DEST}".*.old

# New payload landed: restart service process (ExecStart shell wrapper execs binary,
# restart picks up new one).
systemctl try-restart landscape-router.service

echo "basalt-landscape-update: payload updated → ${DEST}"