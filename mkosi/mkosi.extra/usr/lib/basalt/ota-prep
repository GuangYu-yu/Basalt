#!/bin/sh
# OTA pre-flight space readiness (called by systemd-sysupdate.service wrapper):
# btrfs resize extends filesystem (x-systemd.growfs only runs once during the
# mount window; this catches the case where first-boot growth missed that
# window). Idempotent no-op when already grown. Partition-level growth handled
# every boot by initrd systemd-repart (92-var-grow.conf Weight=100), no repeat
# call here.
btrfs filesystem resize max /var