#!/bin/sh
# =============================================================================
# mkosi.postinst — chroot 内后置安装（零网络：发布物由 build.sh 宿主侧下载）
#
# btrfs 部署子卷路径契约（/usr-etc-var 三分）：
#   /usr /etc  随版本原子更新的部署内容（root-basalt-<v> 子卷，全根可写）
#   /var       运行期挂载 @data（用户/应用数据 + 设备身份 state 目录）
#   landscape 载荷三件套（webserver/static/toml）不在根树——由 pass2 灌装
#   @landscape 子卷（/var/lib/basalt/landscape 挂载点），与 root OTA 解耦
# =============================================================================
set -eu

# 状态目录 → btrfs /var（运行期可写）。兼容层：/root/.landscape-router
# 是上游硬编码 HOME 路径，做成指向 /var 的 symlink 承接运行时写入
ln -sfn /var/lib/landscape /root/.landscape-router

# 服务启用/禁用由 system-preset 声明（30-landscape.preset，mkosi 原生
# preset-all 应用）：ssh/networking 为 readiness 契约；chrony 单 NTP 客户端；
# sysupdate.timer 设备侧更新（部署子卷 + UKI 成对落盘）定时检查
# （sysupdate-reboot.timer 不启用，重启时机由部署方决定）；
# resolved/NetworkManager disable 防第二网络栈。
# 分区/文件系统扩容由 initrd 内 systemd-repart + x-systemd.growfs 完成

# os-release 双层身份模型（os-release(5)：/etc 优先于 /usr/lib，两者可独立）：
#   /usr/lib/os-release = Basalt appliance/启动身份 —— mkosi UKI .osrel 的固定
#     输入源；VERSION_ID 刻意映射为 IMAGE_VERSION，构成 systemd-boot Type 2
#     条目排序契约（VERSION_ID == IMAGE_VERSION == OTA 版本，单一事实源）。
#   /etc/os-release     = Debian 运行兼容身份（独立真实文件，非 symlink）——
#     apt/发行版识别、ProtectVersion=%A、readiness 契约的消费域；完整自洽，
#     不与 /usr/lib 合并（规范无合并语义）。
# IMAGE_ID/IMAGE_VERSION 由 build.sh 经 --environment 显式注入。
# 身份块同源三处（修改须同步）：此处（/usr/lib/os-release）、
# build.sh（rescue 的 basalt.osrel）、tests/ota_lib.sh（伪造 UKI）
sed -i "/^IMAGE_ID=/d;/^IMAGE_VERSION=/d" /usr/lib/os-release
rm -f /etc/os-release
{
    cat /usr/lib/os-release
    printf 'IMAGE_ID=%s\nIMAGE_VERSION=%s\n' "${IMAGE_ID}" "${IMAGE_VERSION}"
} > /etc/os-release
cat > /usr/lib/os-release <<EOF
ID=basalt
NAME="Basalt"
PRETTY_NAME="Basalt ${IMAGE_VERSION}"
VERSION_ID=${IMAGE_VERSION}
IMAGE_ID=${IMAGE_ID}
IMAGE_VERSION=${IMAGE_VERSION}
EOF