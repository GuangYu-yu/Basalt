#!/bin/sh
# =============================================================================
# mkosi.postinst — chroot 内后置安装（零网络：发布物由 build.sh 宿主侧下载、
# --extra-tree 注入）
#
# 只读根(EROFS)路径契约：
#   运行期可写 = overlay 全根增量层(btrfs /var) + tmpfs(/run /tmp /sys/fs/bpf)
#   landscape-webserver 的持久化状态（landscape_init.toml 等）必须位于 /var，
#   静态资源(前端)留在只读根 —— 它们就是镜像内容的一部分。
#   服务单元用 WorkingDirectory 指向 /var/lib/landscape 承接状态写。
# =============================================================================
set -eu

# 发布物落位：二进制 → 只读根，静态资源解压 → 只读根，zip 用后即删
# （勿放 /tmp：chroot sandbox 以 tmpfs 遮蔽镜像树 /tmp）
chmod +x /root/landscape-webserver
mkdir -p /usr/share/landscape/static
unzip -oq /root/static.zip -d /usr/share/landscape/static/
rm -f /root/static.zip

# 状态目录 → btrfs /var（运行期可写）。兼容层：/root/.landscape-router
# 是上游硬编码路径，做成指向 /var 的 symlink 承接运行时写入
ln -sfn /var/lib/landscape /root/.landscape-router

# 服务启用/禁用由 system-preset 声明（30-landscape.preset，mkosi 原生
# preset-all 应用）：ssh/networking 为 readiness 契约；chrony 单 NTP 客户端；
# sysupdate.timer 设备侧文件轮转更新（EROFS 镜像 + UKI 成对落盘）定时检查
# （sysupdate-reboot.timer 不启用，重启时机由部署方决定）；
# resolved/NetworkManager disable 防第二网络栈。
# 分区/文件系统扩容由 initrd 内 systemd-repart + x-systemd.growfs 完成