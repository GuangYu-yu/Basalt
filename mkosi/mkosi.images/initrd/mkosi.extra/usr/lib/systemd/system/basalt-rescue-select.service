# rescue 动态根发现（basalt.rescue=1 激活；正常启动路径零开销——Condition
# 不满足即整单元跳过）
# rescue UKI 是永久条目，cmdline 不能固化 subvol=root-basalt-N（N 随更新
# 递增），且必须整体不带 root=——残留 root=（无 subvol）会让 fstab-generator
# 生成挂 DefaultSubvolume=@data 的 sysroot.mount（@data 无系统，必死），且
# 与本单元的挂载冲突（EBUSY）。无 root= 时本单元是 /sysroot 的唯一提供者。
# 机制（systemd initrd 官方结构核对）：/sysroot 挂载完成 → initrd-root-fs.target
# 达成 → initrd-fs.target → initrd.target → initrd-cleanup isolate
# initrd-switch-root.target → switch-root。本单元必须接入 initrd-root-fs.target
# 完成链（Wants + 让 initrd-root-fs.target After= 本单元，见配套 drop-in）才能
# 阻塞 cleanup/switch-root；仅 initrd.target Wants= 只保证启动不保证完成——
# 实测 initrd.target 在挂载未完成即达成，cleanup isolate 抢先 SIGTERM 本单元，
# /sysroot 空 → switch-root 失败 "os-release file is missing"。本单元 Before=
# initrd-root-fs.target 排在其达成之前，配合 root-fs.target 的 Wants+After 拉起。
# 枚举为空（池损坏/无部署）：exit 1 → 单元失败 → initrd emergency（rescue
# 语义的最后兜底，不 panic 不阻塞）。选中部署若为 ro（deployments-readonly
# 收敛过）先翻 rw——应急维护需要可写根。
[Unit]
Description=Basalt rescue: discover and mount newest deployment
DefaultDependencies=no
ConditionKernelCommandLine=basalt.rescue=1
After=dev-disk-by\x2dpartlabel-var.device
Wants=initrd-root-fs.target
Before=initrd-root-fs.target initrd-switch-root.target

[Service]
Type=oneshot
# 单行命令：unit 语法引号不可跨行。sort -V 取版本号最高者。
# 设备等待：After= 对从未激活的 device 单元是空排序（rescue 无 root=，udev
# 处理时序不受 fstab-generator 约束，by-partlabel 符号链接可能晚于本单元就绪），
# 脚本内轮询兜底；-t btrfs 显式指定（fs 类型由 mkosi.repart 单一事实源决定）
ExecStart=/bin/sh -c 'exec >/dev/console 2>&1; mkdir -p /run/basalt-rescue-pool /sysroot; i=0; while [ ! -e /dev/disk/by-partlabel/var ] && [ "$i" -lt 60 ]; do sleep 1; i=$((i+1)); done; mount -t btrfs -o subvolid=5 /dev/disk/by-partlabel/var /run/basalt-rescue-pool || { echo "basalt-rescue-select: pool mount failed"; exit 1; }; latest="$(ls -d /run/basalt-rescue-pool/root-basalt-[0-9]* 2>/dev/null | sort -V | tail -1)"; [ -n "$latest" ] || { echo "basalt-rescue-select: no root-basalt-* deployment found"; exit 1; }; subvol="$(basename "$latest")"; if btrfs property get -ts "$latest" ro 2>/dev/null | grep -q "^ro=true$"; then btrfs property set -ts "$latest" ro false || { echo "basalt-rescue-select: ro->rw failed for $subvol"; exit 1; }; fi; mount -t btrfs -o "subvol=$subvol,compress=zstd:1,noatime,rw" /dev/disk/by-partlabel/var /sysroot && echo "basalt-rescue-select: sysroot=$subvol" || { echo "basalt-rescue-select: sysroot mount failed"; exit 1; }'
RemainAfterExit=yes
