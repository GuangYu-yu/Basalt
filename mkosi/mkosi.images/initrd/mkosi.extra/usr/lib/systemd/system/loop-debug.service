# 临时诊断服务：initrd-root-overlay 挂 EROFS 前 dump loop 模块运行时状态，
# 定位 mount -o loop "failed to setup loop device" 环节（静态含 loop.ko.xz
# 但运行时 setup 失败）。由 initrd-root-overlay.service.d/10-loop-debug.conf
# 的 Wants= 拉起，Before= 保证先于 overlay 挂载执行；用后即删，不进最终产物。
[Unit]
Description=loop runtime module probe (temporary debug)
DefaultDependencies=no
Before=initrd-root-overlay.service

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/systemd/loop-debug.sh
StandardOutput=console
StandardError=console
