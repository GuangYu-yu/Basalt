# 临时诊断服务：在 systemd-modules-load 处理 btrfs.conf 之前 dump 模块树并
# modprobe -v -v 定位 btrfs ENOENT 环节（静态产物含 btrfs.ko.xz 但运行时失败）。
# 由 systemd-modules-load.service.d/90-btrfs-debug.conf 的 Wants= 拉起，
# Before= 保证先于 modules-load 执行；用后即删，不进最终产物。
[Unit]
Description=btrfs runtime module tree probe (temporary debug)
DefaultDependencies=no
Before=systemd-modules-load.service

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/systemd/btrfs-debug.sh
StandardOutput=console
StandardError=console
