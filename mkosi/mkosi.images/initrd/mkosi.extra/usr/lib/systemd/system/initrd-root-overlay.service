[Unit]
Description=Assemble writable root overlay (EROFS lower + btrfs upper)
DefaultDependencies=no
# sysroot = root= cmdline 指向的 EROFS 根（initrd 语境由 cmdline 生成 sysroot.mount）。
# dev-disk-by-partlabel-var.device = udev 为 var 分区建好的 by-partlabel 符号链接的
# 设备单元：repart/udev 异步，mount PARTLABEL=var 依赖该链接，必须显式排序
After=sysroot.mount systemd-repart.service dev-disk-by\x2dpartlabel-var.device
# 失败不阻塞 switch_root：退化为纯只读根继续启动
OnFailure=initrd-switch-root.target
OnFailureJobMode=replace-irreversibly

# 为什么在 initrd 里做：
#   systemd-fstab-generator 对 / 只生成 remount 语义，不会在真实根阶段把
#   erofs 的 / 换成 overlay（fstab overlay / 条目永远不生效）；而 overlay
#   涉及两个设备（EROFS 根 + btrfs /var），fstab-generator 无法表达多设备
#   根（systemd 上游不支持多设备根 fstab 表达）。OpenWrt/Android/overlayroot
#   均在 initramfs 阶段组装全根 overlay —— 本单元即该步骤的声明式最小实现。
#
# 挂载编排（顺序敏感）：
#   1. var 分区先挂到 initrd 中性路径 /run/var（upper/work 必须与 lower
#      不同文件系统，此处 upper/work 所在 btrfs 尚无其他挂载点）
#   2. overlay 叠到 /sysroot 上（shadow 住 EROFS sysroot；lowerdir=/sysroot
#      在挂载瞬间解析为 EROFS 内容，overlayfs 会 pin 住底层挂载）
#   3. switch_root 后：/ = overlay；/var 由真实根 fstab 挂载同一 btrfs
#      （重复挂载同一 btrfs 合法且视图一致），x-systemd.growfs 在该挂载上
#      完成文件系统扩展 —— 因此这里刻意不做 move-mount
[Service]
Type=oneshot
# 单行命令：unit 语法引号不可跨行（多行引号会被判 Unbalanced quoting，
# 整个 unit 拒载）
# var 挂载带重试：首启 systemd-repart 扩分区表触发 udev 重枚举，
# 单发 mount 可能撞上设备暂不可解析的窗口（间歇性 ENOENT），
# 30s 预算覆盖 repart + udev 稳定时间
ExecStart=/bin/sh -ec 'exec >/dev/console 2>&1; mkdir -p /run/var /run/var/lib/etc/upper /run/var/lib/etc/work; i=0; until mount -t btrfs -o compress=zstd:1,noatime PARTLABEL=var /run/var; do i=$((i+1)); [ $i -ge 15 ] && echo "var mount failed after $i attempts" && exit 1; sleep 2; done; mount -t overlay -o lowerdir=/sysroot,upperdir=/run/var/lib/etc/upper,workdir=/run/var/lib/etc/work overlay /sysroot'
RemainAfterExit=yes