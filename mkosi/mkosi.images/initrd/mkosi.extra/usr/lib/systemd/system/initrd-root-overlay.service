[Unit]
Description=Assemble writable root overlay (EROFS file lower + btrfs @os upper)
DefaultDependencies=no
# sysroot.mount = root=/rootflags= 生成的 btrfs @os 挂载（initrd 语境由 cmdline
# 经 fstab-generator 生成）。dev-disk-by\x2dpartlabel-var.device = udev 为 var
# 分区建好的 by-partlabel 符号链接的设备单元：repart/udev 异步，依赖该链接必须
# 显式排序（repart 重枚举窗口由下方 mount 重试覆盖）。
# 无 OnFailure 退化路径：sysroot=@os（非可启动根），组装失败必须进 initrd
# emergency（systemd 默认行为），由 rescue UKI / 串口 console 承接排障。
After=sysroot.mount systemd-repart.service dev-disk-by\x2dpartlabel-var.device

# 挂载编排（顺序敏感）：
#   1. sysroot.mount（@os）由 root=/rootflags 生成——btrfs 上承接 overlay
#      upper/work（跨版本共享：/etc 等系统状态是"当前状态"而非版本属性，
#      回滚只切换 EROFS lower）
#   2. @images 子卷只读挂到 /sysroot/images（同 var 设备第二挂载；
#      sysroot.mount 已成功意味着设备节点稳定，无需重试）。@os 内的
#      images/ 仅为挂载点占位目录，真实镜像在 @images 子卷根
#   3. loop 只读挂 /sysroot/images/basalt_<v>.erofs → /run/root-image
#   4. overlay 叠到 /sysroot：lowerdir=loop 镜像，upper/work=@os/overlay/*
#      （挂载瞬间解析，overlayfs pin 底层挂载）
#   5. switch_root 后：/ = overlay；/var 由真实根 fstab 以 subvol=@data 挂
#      同一 btrfs；/var/lib/basalt 再以 subvol=@os 挂载，/var/lib/basalt/
#      images 以 subvol=@images,ro 挂载（默认 ro，sysupdate rw wrapper 窗口
#      外不可写）
# basalt.ro=1（rescue UKI）：跳过 overlay，双 move 得纯只读 EROFS 根
[Service]
Type=oneshot
# 单行命令：unit 语法引号不可跨行（多行引号会被判 Unbalanced quoting，
# 整个 unit 拒载）
# loop 挂载带重试：首启 systemd-repart 扩分区表触发 udev 重枚举，单发
# mount 可能撞上设备暂不可解析的窗口（间歇性 ENOENT），30s 预算覆盖
# repart + udev 稳定时间
# 临时诊断：[debug] 段取证 /sysroot 只读根因（overlay upper 报 read-only）：
# 实际挂载选项 / 写测试 / btrfs 子卷 ro 属性；用后即删。
ExecStart=/bin/sh -ec 'exec >/dev/console 2>&1; echo "[debug] cmdline:"; cat /proc/cmdline; echo "[debug] sysroot mount:"; findmnt -no SOURCE,FSTYPE,OPTIONS /sysroot 2>&1 || true; grep -a " /sysroot " /proc/mounts 2>&1 || true; echo "[debug] sysroot write test:"; if touch /sysroot/.rw-test 2>&1; then echo "[debug] WRITE-OK"; rm -f /sysroot/.rw-test; else echo "[debug] WRITE-FAIL"; fi; echo "[debug] btrfs subvolume ro:"; btrfs property get /sysroot ro 2>&1 || true; btrfs property get -t btrfs /sysroot ro 2>&1 || true; echo "[debug] rootflags:"; tr " " "\n" < /proc/cmdline | grep -aE "^(ro|rw|rootflags|systemd.volatile|roothash)" 2>&1 || true; img="$(sed -n "s/.*basalt.image=\([^ ]*\).*/\1/p" /proc/cmdline)"; [ -n "$img" ] || { echo "basalt.image= missing on cmdline"; exit 1; }; mkdir -p /sysroot/images; mount -o ro,subvol=@images /dev/disk/by-partlabel/var /sysroot/images; mkdir -p /run/root-image; i=0; until mount -o ro,loop /sysroot/images/"$img" /run/root-image; do i=$((i+1)); [ $i -ge 15 ] && echo "erofs loop mount failed after $i attempts: $img" && exit 1; sleep 2; done; if grep -q "basalt.ro=1" /proc/cmdline; then mkdir -p /run/osroot; mount --move /sysroot /run/osroot; mount --move /run/root-image /sysroot; else mkdir -p /sysroot/overlay/upper /sysroot/overlay/work; mount -t overlay -o lowerdir=/run/root-image,upperdir=/sysroot/overlay/upper,workdir=/sysroot/overlay/work overlay /sysroot; fi'
RemainAfterExit=yes