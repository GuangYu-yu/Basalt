#!/bin/sh
# emergency 取证转储：sysroot 挂载失败（emergency 唯一入口）时自动执行。
# SSH 已死、串口是唯一观察面——把池子卷账目（部署子卷存在性/ro 属性）、
# ESP UKI 清单、持久 journal 尾部直接打到 console，实锤"更新失败后池里
# 剩什么"（如：受保护运行部署是否被 sysupdate 误删）。全部只读，失败不
# 阻断 sulogin（ExecStartPre=- 前缀兜底）。
exec >/dev/console 2>&1

echo "=== [emergency-dump] 池子卷账目 ==="
if mount -o subvolid=5 /dev/disk/by-partlabel/var /mnt 2>/dev/null; then
    ls -la /mnt 2>/dev/null
    btrfs subvolume list -o /mnt 2>/dev/null | head -n 40
    btrfs subvolume list /mnt 2>/dev/null | head -n 40
    for s in /mnt/root-basalt-*; do
        [ -e "$s" ] || continue
        echo "$s: ro=$(btrfs property get -ts "$s" ro 2>/dev/null)"
    done
    # 冻结/失败 boot 的持久 journal（journald Storage=persistent，@data 内）
    if [ -d /mnt/@data/var/log/journal ]; then
        echo "=== [emergency-dump] journal 尾部（全部 boot）==="
        journalctl --directory=/mnt/@data/var/log/journal --no-pager -n 60 2>/dev/null | tail -n 60
    else
        echo "（@data 无持久 journal 目录）"
    fi
    umount /mnt 2>/dev/null
else
    echo "（var 池顶层挂载失败——btrfs 超级块/分区层面异常）"
fi

echo "=== [emergency-dump] ESP UKI 清单 ==="
if mount /dev/disk/by-partlabel/ESP /mnt 2>/dev/null || mount /dev/vda1 /mnt 2>/dev/null; then
    ls -la /mnt/EFI/Linux 2>/dev/null
    umount /mnt 2>/dev/null
else
    echo "（ESP 挂载失败）"
fi
exit 0
